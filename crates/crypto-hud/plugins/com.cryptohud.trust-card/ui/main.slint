export struct QuoteRow {
    symbol: string,
    price: string,
    change: string,
    positive: bool,
}

export component TrustCard inherits Window {
    in property <string> widget-id;
    in property <[QuoteRow]> quote-rows;
    in property <[image]> quote-icons;
    in property <[bool]> quote-price-ready;
    property <image> empty-quote-icon;
    in property <string> pairs-heading-text;
    in property <string> source-text;
    in property <string> source-name-text: root.source-text;
    in property <string> updated-text;
    in property <string> empty-text;
    in property <string> layout-lock-text;
    in property <string> change-period-text;
    in property <bool> rtl-layout: false;
    in property <bool> pin-to-top;
    in property <bool> layout-locked;
    in property <int> widget-width: 260;
    in property <int> widget-height: 180;
    in property <float> widget-scale: 1.0;
    in property <bool> red-up-enabled;
    in property <int> content-opacity;
    in property <string> theme-name: "dark";
    in property <string> chart-line-path;
    in property <string> chart-fill-path;
    in property <bool> chart-ready;
    in property <bool> chart-positive;
    in property <int> chart-end-y-ratio: 500;
    // Optional host input; cached prices can exist while the feed is unhealthy.
    in property <bool> market-status-warning: false;
    in-out property <bool> card-left-drag-active: false;
    in-out property <bool> show-lock-focus: false;

    property <bool> light-theme: root.theme-name == "light";
    property <float> content-scale: root.widget-scale;
    property <length> card-x: 10px;
    property <length> card-y: 10px;
    property <length> card-width: 240px;
    property <length> card-height: 160px;
    property <length> card-radius: 14px;
    property <bool> price-ready: root.quote-rows.length > 0
        && (root.quote-price-ready.length == 0 || root.quote-price-ready[0]);
    property <bool> chart-uses-gain-color: root.chart-positive ? !root.red-up-enabled : root.red-up-enabled;
    property <color> primary-text-color: root.light-theme ? #102e23 : #f0f6ed;
    property <color> secondary-text-color: root.light-theme ? #688078 : #92a99c;
    property <color> gain-color: root.light-theme ? #087b5c : #6cd3ae;
    property <color> loss-color: root.light-theme ? #ce5360 : #f37c8a;
    property <color> chart-color: root.chart-uses-gain-color ? root.gain-color : root.loss-color;
    property <color> gain-pill-background: root.light-theme ? #087b5c1b : #6cd3ae1a;
    property <color> loss-pill-background: root.light-theme ? #ce536012 : #f37c8a14;
    property <color> lock-background: root.light-theme ? #e3eee6 : #203c30;
    property <color> lock-hover-background: root.light-theme ? #d5e6dc : #304d3e;
    property <color> focus-color: root.light-theme ? #36735c : #8dd8b9;
    property <color> surface-top: root.light-theme ? #e1ebe4 : #173528;
    property <color> surface-bottom: root.light-theme ? #edf5ee : #1c392c;
    property <bool> lock-revealed: drag_area.has-hover || lock_button_hit_area.has-hover
        || lock_button_hit_area.pressed || root.card-left-drag-active
        || (root.show-lock-focus && lock_focus.has-focus);
    property <bool> header-details-revealed: (drag_area.has-hover
        && !lock_button_hit_area.has-hover && !lock_button_hit_area.pressed
        && drag_area.mouse-x >= card.x + root.s(16px)
        && drag_area.mouse-x < card.x + root.s(224px)
        && drag_area.mouse-y >= card.y + root.s(14px)
        && drag_area.mouse-y < card.y + root.s(52px))
        || (root.show-lock-focus && lock_focus.has-focus);
    property <color> warning-color: root.light-theme ? #8c662f : #e4bd7c;
    property <bool> status-visible: root.quote-rows.length > 0
        && (root.header-details-revealed || !root.price-ready || !root.chart-ready || root.market-status-warning);
    property <string> measured-price: root.price-ready ? root.quote-rows[0].price : root.price-slot-reference;
    property <string> measured-change: root.price-ready ? root.quote-rows[0].change : "—";
    property <length> price-font-size: root.s(42px) * min(1,
        (root.s(208px) - max(root.s(2px), 2px)) / max(1px, max(price_slots.preferred-width, price_measure.preferred-width)));

    callback drag-move(length, length);
    callback toggle-layout-lock();

    function s(value: length) -> length {
        return value * root.content-scale;
    }

    title: root.widget-id;
    width: root.widget-width * 1px;
    height: root.widget-height * 1px;
    no-frame: true;
    always-on-top: root.pin-to-top;
    background: transparent;
    default-font-family: "Segoe UI";
    forward-focus: lock_focus;

    // Measure at the maximum size, never at the fitted size.
    price_measure := Text {
        text: root.measured-price;
        font-size: root.s(42px);
        font-weight: 700;
        visible: false;
    }
    property <string> price-slot-reference: "88888888";
    price_slots := Text {
        text: root.price-slot-reference;
        font-size: root.s(42px);
        font-weight: 700;
        visible: false;
    }
    change_measure := Text {
        text: root.measured-change;
        font-size: root.s(16px);
        font-weight: 700;
        visible: false;
    }

    drag_area := TouchArea {
        width: root.widget-width * 1px;
        height: root.widget-height * 1px;
        mouse-cursor: root.layout-locked ? default : (self.pressed ? grabbing : grab);
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.show-lock-focus = false; }
            if !root.layout-locked && event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.card-left-drag-active = true;
            } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                root.card-left-drag-active = false;
            }
        }
        moved => {
            if !root.layout-locked && root.card-left-drag-active {
                root.drag-move(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
    }

    // The software renderer omits BoxShadow. Low-alpha rounded layers provide
    // the same restrained elevation without a fixed-resolution material image.
    for layer in 10 : Rectangle {
        property <length> spread: root.s((10 - layer) * 0.55px);
        x: root.s(root.card-x) - self.spread;
        y: root.s(root.card-y + 3px) - self.spread;
        width: root.s(root.card-width) + 2 * self.spread;
        height: root.s(root.card-height) + 2 * self.spread;
        border-radius: root.s(root.card-radius) + self.spread;
        background: root.light-theme ? #17382a04 : #00000006;
        opacity: root.content-opacity / 100;
    }

    card := Rectangle {
        // Align the origin as well as the gradient slices. Fractional global
        // clip edges otherwise leave cleared rows during software partial redraw.
        x: round(root.s(root.card-x) / 1phx) * 1phx;
        y: round(root.s(root.card-y) / 1phx) * 1phx;
        width: root.s(root.card-width); height: root.s(root.card-height);
        border-radius: root.s(root.card-radius);
        background: transparent;
        opacity: root.content-opacity / 100;
        clip: true;

        // Slint's software gradient path does not clip to rounded corners.
        // Physical-pixel-aligned slices of solid rounded rectangles do.
        for band in 64 : Rectangle {
            y: floor(band * card.height / 64 / 1phx) * 1phx;
            width: card.width;
            height: floor((band + 1) * card.height / 64 / 1phx) * 1phx - self.y;
            background: transparent;
            clip: true;
            Rectangle {
                y: -parent.y;
                width: card.width; height: card.height;
                border-radius: root.s(root.card-radius);
                background: root.surface-bottom.mix(root.surface-top, band / 63.0);
            }
        }
        Rectangle {
            width: parent.width; height: parent.height;
            border-radius: root.s(root.card-radius);
            background: transparent;
            border-width: root.s(1px);
            border-color: root.light-theme ? #ffffffe0 : #7aa78a40;
        }

        for quote[index] in root.quote-rows : Rectangle {
            width: parent.width;
            height: parent.height;
            visible: index == 0;
            background: transparent;

            quote_icon := Image {
                x: root.s(16px); y: root.s(14px);
                width: root.s(38px); height: root.s(38px);
                source: root.quote-icons.length > index ? root.quote-icons[index] : root.empty-quote-icon;
                image-fit: contain;
                visible: root.quote-icons.length > index;
            }
            symbol_text := Text {
                x: root.quote-icons.length > index ? root.s(66px) : root.s(16px);
                y: root.s(14px);
                width: parent.width - self.x - root.s(16px);
                height: root.s(38px);
                text: quote.symbol;
                color: root.primary-text-color;
                font-size: root.s(16px);
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            price_text := Text {
                x: root.s(16px); y: root.s(54px);
                width: root.s(208px); height: root.s(54px);
                text: root.price-ready ? quote.price : "—";
                color: root.price-ready ? root.primary-text-color : root.secondary-text-color;
                font-size: root.price-font-size;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }

            change_pill := Rectangle {
                x: root.s(16px); y: root.s(114px);
                width: min(root.s(72px), change_measure.preferred-width + root.s(14px));
                height: root.s(28px);
                border-radius: root.s(7px);
                visible: !root.status-visible;
                background: !root.price-ready ? transparent : quote.positive
                    ? (root.red-up-enabled ? root.loss-pill-background : root.gain-pill-background)
                    : (root.red-up-enabled ? root.gain-pill-background : root.loss-pill-background);
                change_text := Text {
                    x: root.s(7px);
                    width: parent.width - root.s(14px); height: parent.height;
                    text: root.price-ready ? quote.change : "—";
                    color: !root.price-ready ? root.secondary-text-color : quote.positive
                        ? (root.red-up-enabled ? root.loss-color : root.gain-color)
                        : (root.red-up-enabled ? root.gain-color : root.loss-color);
                    font-size: root.s(16px) * min(1, self.width / max(1px, change_measure.preferred-width));
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            change_period := Text {
                x: change_pill.x + change_pill.width + root.s(7px);
                y: change_pill.y;
                width: root.s(133px) - self.x;
                height: change_pill.height;
                text: root.change-period-text;
                color: root.secondary-text-color;
                font-size: root.s(12px);
                vertical-alignment: center;
                horizontal-alignment: root.rtl-layout ? right : left;
                visible: root.price-ready && !root.status-visible;
                overflow: elide;
            }

            chart := Rectangle {
                x: floor(root.s(137px) / 1phx) * 1phx;
                y: floor(root.s(113px) / 1phx) * 1phx;
                // Slint 1.17's software Path blends outside the dirty region.
                // Changing only this transparent guard invalidates the complete
                // plot on hover; the visible line and endpoint stay fixed.
                width: ceil(root.s(86px) / 1phx) * 1phx + (root.lock-revealed ? 1phx : 0phx);
                height: ceil(root.s(32px) / 1phx) * 1phx;
                background: transparent;
                clip: true;
                visible: root.chart-ready && root.price-ready && !root.status-visible;
                chart_line := Path {
                    x: round(root.s(140px) / 1phx) * 1phx - chart.x;
                    y: round(root.s(116px) / 1phx) * 1phx - chart.y;
                    width: root.s(80px); height: root.s(26px);
                    viewbox-width: 100; viewbox-height: 40;
                    fit: fill;
                    commands: root.chart-line-path;
                    fill: transparent;
                    stroke: root.chart-color;
                    stroke-width: root.s(1.8px);
                    stroke-line-cap: round;
                    stroke-line-join: round;
                }
                Rectangle {
                    x: chart_line.x + chart_line.width - self.width / 2;
                    y: chart_line.y + chart_line.height * clamp(root.chart-end-y-ratio, 0, 1000) / 1000 - self.height / 2;
                    width: root.s(5px); height: self.width;
                    border-radius: self.width / 2;
                    background: root.chart-color;
                }
            }
        }

        // Header hover reveals details without intercepting dragging. Hovering
        // elsewhere only reveals the lock and preserves the normal bottom row.
        // Stale cached values and failures keep their status visible at rest.
        status_source := Text {
            x: root.s(16px); y: root.s(111px);
            width: root.s(208px); height: root.s(24px);
            text: root.market-status-warning || !root.chart-ready
                ? root.source-text : root.source-name-text;
            color: root.market-status-warning ? root.warning-color : root.secondary-text-color;
            font-size: root.s(10px);
            font-weight: 600;
            horizontal-alignment: root.rtl-layout ? right : left;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
            visible: root.status-visible;
        }
        status_text := Text {
            x: root.s(16px); y: root.s(137px);
            width: root.s(208px); height: root.s(16px);
            text: root.updated-text;
            color: root.market-status-warning ? root.warning-color : root.secondary-text-color;
            font-size: root.s(11px);
            wrap: word-wrap;
            overflow: elide;
            horizontal-alignment: root.rtl-layout ? right : left;
            vertical-alignment: top;
            visible: root.status-visible;
        }
        empty_text := Text {
            x: root.s(16px); y: root.s(54px);
            width: root.s(208px); height: root.s(52px);
            text: root.empty-text;
            color: root.secondary-text-color;
            font-size: root.s(14px);
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            visible: root.quote-rows.length == 0;
            overflow: elide;
        }
    }

    // Floating control does not reflow the pair; pointer focus must not pin it open.
    lock_button := Rectangle {
        x: card.x + card.width - max(root.s(34px), 22px);
        y: card.y + root.s(12px);
        width: max(root.s(26px), 18px); height: self.width;
        border-radius: root.s(6px);
        background: lock_button_hit_area.has-hover ? root.lock-hover-background : root.lock-background;
        border-width: root.show-lock-focus && lock_focus.has-focus ? 1.5px : 0px;
        border-color: root.focus-color;
        opacity: root.lock-revealed ? root.content-opacity / 100 : 0;
        forward-focus: lock_focus;
        accessible-role: checkbox;
        accessible-label: root.layout-lock-text;
        accessible-checkable: true;
        accessible-checked: root.layout-locked;
        accessible-action-default => { root.toggle-layout-lock(); }
        Image {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: max(root.s(16px), 12px); height: self.width;
            source: root.layout-locked ? @image-url("icons/lock.svg") : @image-url("icons/unlock.svg");
            colorize: root.secondary-text-color;
            image-fit: contain;
        }
        lock_button_hit_area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.show-lock-focus = false;
                lock_focus.focus();
                root.toggle-layout-lock();
            }
        }
        lock_focus := FocusScope {
            width: 0px; height: 0px;
            key-pressed(event) => {
                root.show-lock-focus = true;
                if !event.repeat && (event.text == Key.Space || event.text == Key.Return) {
                    root.toggle-layout-lock();
                    return accept;
                }
                return reject;
            }
        }
    }
}
