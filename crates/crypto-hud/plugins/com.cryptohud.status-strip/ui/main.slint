export struct QuoteRow {
    symbol: string,
    price: string,
    change: string,
    positive: bool,
}

// Physical-pixel-aligned rounded slices keep the original gloss and shading
// consistent in the software renderer, including partial redraw and opacity.
component StatusStripFill inherits Rectangle {
    in property <int> tone-index;
    in property <int> edge-kind;
    in property <bool> light-theme;
    in property <bool> ready;
    in property <length> radius;
    property <color> top: !root.ready ? (root.light-theme ? #7b8c98 : #394954)
        : (root.tone-index == 0 ? (root.light-theme ? #1ab5cd : #167c95)
        : (root.tone-index == 1 ? (root.light-theme ? #29a2d7 : #276b9e)
        : (root.tone-index == 2 ? (root.light-theme ? #f79d25 : #b57529)
        : (root.tone-index == 3 ? (root.light-theme ? #dbcc27 : #93892b)
        : (root.light-theme ? #52b868 : #397c50)))));
    property <color> bottom: !root.ready ? (root.light-theme ? #4e6474 : #202d37)
        : (root.tone-index == 0 ? (root.light-theme ? #128bb1 : #0c4c66)
        : (root.tone-index == 1 ? (root.light-theme ? #1f6ebc : #183b67)
        : (root.tone-index == 2 ? (root.light-theme ? #e55e1f : #773d24)
        : (root.tone-index == 3 ? (root.light-theme ? #b5aa16 : #5c5418)
        : (root.light-theme ? #288b52 : #204c37)))));
    property <color> highlight: !root.ready ? (root.light-theme ? #a5b4bf : #61717b)
        : (root.tone-index == 0 ? (root.light-theme ? #86dfea : #62a8b9)
        : (root.tone-index == 1 ? (root.light-theme ? #92d7f1 : #7098b9)
        : (root.tone-index == 2 ? (root.light-theme ? #ffda8d : #cbaa6b)
        : (root.tone-index == 3 ? (root.light-theme ? #f3ec8c : #b3ab68)
        : (root.light-theme ? #b0e6b8 : #83ac8b)))));
    function shade(position: float) -> color {
        if position < 0.05 { return root.top.mix(root.highlight, position / 0.05); }
        return root.bottom.mix(root.top, max(0, (position - 0.25) / 0.75));
    }
    background: transparent;
    clip: true;
    for band in 64 : Rectangle {
        y: floor(band * root.height / 64 / 1phx) * 1phx;
        width: root.width;
        height: floor((band + 1) * root.height / 64 / 1phx) * 1phx - self.y;
        background: transparent;
        clip: true;
        Rectangle {
            y: -parent.y;
            width: root.width; height: root.height;
            border-top-left-radius: root.edge-kind == 1 || root.edge-kind == 3 ? root.radius : 0px;
            border-bottom-left-radius: self.border-top-left-radius;
            border-top-right-radius: root.edge-kind == 2 || root.edge-kind == 3 ? root.radius : 0px;
            border-bottom-right-radius: self.border-top-right-radius;
            background: root.shade(band / 63.0);
        }
    }
}

export component StatusStrip inherits Window {
    in property <string> widget-id;
    in property <[QuoteRow]> quote-rows;
    in property <[bool]> quote-price-ready;
    in property <[int]> quote-cell-widths;
    in property <string> pairs-heading-text;
    in property <string> source-text;
    in property <string> source-name-text: root.source-text;
    in property <string> updated-text;
    in property <string> empty-text;
    in property <string> layout-lock-text;
    in property <string> change-period-text;
    in property <bool> market-status-warning: false;
    in property <bool> rtl-layout: false;
    in property <bool> pin-to-top;
    in property <bool> layout-locked;
    in property <int> widget-width: 618;
    in property <int> widget-height: 92;
    in property <float> widget-scale: 1.0;
    in property <bool> red-up-enabled;
    in property <int> content-opacity;
    in property <string> theme-name: "light";
    in-out property <bool> card-left-drag-active: false;
    in-out property <bool> show-lock-focus: false;

    property <bool> light-theme: root.theme-name != "dark";
    property <float> content-scale: root.widget-scale;
    property <int> block-count: max(1, min(root.quote-rows.length, 5));
    property <color> surface: root.light-theme ? #f5f8f9 : #18242c;
    property <color> primary: root.light-theme ? #1c303b : #eaf1f5;
    property <color> secondary: root.light-theme ? #526874 : #a5b7c1;
    property <color> edge: root.light-theme ? #718b9b38 : #9bb6c32b;
    property <color> gain: #baffd5;
    property <color> loss: #ffd0d8;
    property <color> gain-contrast: #244b13;
    property <color> loss-contrast: #78351d;
    property <color> warning: #ffe2a3;
    property <bool> lock-revealed: drag_area.has-hover || lock_touch.has-hover
        || lock_touch.pressed || root.card-left-drag-active
        || (root.show-lock-focus && lock_focus.has-focus);
    property <bool> details-visible: drag_area.has-hover && !root.card-left-drag-active
        && ((drag_area.mouse-y >= card.y + root.s(78px)
                && drag_area.mouse-x < lock_button.x - root.s(2px))
            || (root.market-status-warning
                && drag_area.mouse-y < card.y + root.s(20px)
                && drag_area.mouse-x > card.x + card.width - root.s(20px)));
    property <string> status-details-label: root.updated-text + "\n" + root.source-text;
    property <length> canvas-width: root.cell-x(root.block-count);
    property <string> price-slot-reference: "88888888";

    // A fixed eight-digit reference keeps short and tiny prices at the same size.
    price_slots := Text {
        text: root.price-slot-reference;
        font-size: root.s(23px);
        font-weight: 700;
        visible: false;
    }
    function s(value: length) -> length { return value * root.content-scale; }
    function cell-width(index: int) -> length {
        return root.quote-cell-widths.length > index ? root.quote-cell-widths[index] * 1px : 122px;
    }
    function cell-x(index: int) -> length {
        return (index > 0 ? root.cell-width(0) : 0px)
            + (index > 1 ? root.cell-width(1) : 0px)
            + (index > 2 ? root.cell-width(2) : 0px)
            + (index > 3 ? root.cell-width(3) : 0px)
            + (index > 4 ? root.cell-width(4) : 0px);
    }
    callback drag-move(length, length);
    callback toggle-layout-lock();
    title: root.widget-id;
    width: root.widget-width * 1px;
    height: root.widget-height * 1px;
    no-frame: true;
    always-on-top: root.pin-to-top;
    background: transparent;
    default-font-family: "Segoe UI";
    forward-focus: lock_focus;

    drag_area := TouchArea {
        width: root.width; height: root.height;
        mouse-cursor: root.layout-locked ? default : (self.pressed ? grabbing : grab);
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.show-lock-focus = false; }
            if !root.layout-locked && event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.card-left-drag-active = true;
            } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                root.card-left-drag-active = false;
            }
        }
        moved => {
            if !root.layout-locked && root.card-left-drag-active {
                root.drag-move(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
    }

    card := Rectangle {
        x: round((root.width - root.s(root.canvas-width)) / 2 / 1phx) * 1phx;
        y: round((root.height - root.s(84px)) / 2 / 1phx) * 1phx;
        width: round(root.s(root.canvas-width) / 1phx) * 1phx;
        height: round(root.s(84px) / 1phx) * 1phx;
        border-radius: root.s(10px);
        background: root.quote-rows.length == 0 ? root.surface : transparent;
        opacity: root.content-opacity / 100;

        for quote[index] in root.quote-rows : cell := Rectangle {
            property <bool> ready: root.quote-price-ready.length <= index || root.quote-price-ready[index];
            property <bool> use-gain: quote.positive != root.red-up-enabled;
            property <bool> contrast-face: root.light-theme && index == 3 && self.ready;
            property <color> change-color: !self.ready ? self.face-text : (self.use-gain
                ? (self.contrast-face ? root.gain-contrast : root.gain)
                : (self.contrast-face ? root.loss-contrast : root.loss));
            property <color> face-text: self.contrast-face ? #253012 : #ffffff;
            x: round(root.s(root.cell-x(index)) / 1phx) * 1phx; y: 0px;
            width: round(root.s(root.cell-x(index) + root.cell-width(index)) / 1phx) * 1phx - self.x;
            height: card.height;
            visible: index < 5;
            border-top-left-radius: index == 0 ? root.s(10px) : 0px;
            border-top-right-radius: index + 1 == root.block-count ? root.s(10px) : 0px;
            border-bottom-left-radius: index == 0 ? root.s(10px) : 0px;
            border-bottom-right-radius: index + 1 == root.block-count ? root.s(10px) : 0px;
            background: transparent;
            StatusStripFill {
                width: parent.width; height: parent.height;
                tone-index: index; light-theme: root.light-theme; ready: cell.ready;
                radius: root.s(10px);
                edge-kind: root.block-count == 1 ? 3 : (index == 0 ? 1 : (index + 1 == root.block-count ? 2 : 0));
            }
            Text {
                x: root.s(11px); y: root.s(9px);
                width: parent.width - root.s(22px); height: root.s(17px);
                text: quote.symbol; color: cell.face-text;
                font-size: root.s(12px); font-weight: 600;
                overflow: elide; vertical-alignment: center;
            }
            price_text := Text {
                x: root.s(11px); y: root.s(29px);
                width: parent.width - root.s(19px); height: root.s(28px);
                text: quote.price;
                color: cell.face-text;
                font-size: root.s(23px) * min(1,
                    (self.width - max(root.s(2px), 2px)) / max(1px, price_slots.preferred-width));
                font-weight: 700; overflow: elide; vertical-alignment: center;
                visible: cell.ready;
            }
            Text {
                x: price_text.x; y: price_text.y;
                width: price_text.width; height: price_text.height;
                text: "—"; color: cell.face-text;
                font-size: root.s(22px); visible: !cell.ready;
            }
            change_arrow := Image {
                x: root.s(9px); y: root.s(62px);
                width: root.s(12px); height: self.width;
                // Direction follows the quote; the user's red-up preference
                // changes only the shared arrow/percentage color.
                source: quote.positive ? @image-url("icons/caret-up-fill.svg") : @image-url("icons/caret-down-fill.svg");
                colorize: cell.change-color; image-fit: contain;
                visible: cell.ready;
            }
            change_text := Text {
                x: root.s(cell.ready ? 25px : 11px); y: root.s(60px);
                width: period_text.x - root.s(5px) - self.x; height: root.s(17px);
                text: cell.ready ? quote.change : "—";
                color: cell.change-color;
                font-size: root.s(13px); font-weight: 600;
                overflow: elide; vertical-alignment: center;
            }
            period_text := Text {
                x: parent.width - root.s(37px); y: root.s(60px);
                width: root.s(26px); height: root.s(17px);
                text: root.change-period-text; color: cell.face-text;
                font-size: root.s(10px); overflow: elide;
                opacity: 0.78;
                vertical-alignment: center;
                horizontal-alignment: right;
                visible: cell.ready && !(index + 1 == root.block-count && root.lock-revealed);
            }
            Rectangle {
                x: parent.width - 1phx; y: root.s(14px);
                width: 1phx; height: root.s(55px);
                background: #ffffff45; visible: index + 1 < root.block-count;
            }
        }

        empty_label := Text {
            x: root.s(11px); y: root.s(12px);
            width: parent.width - root.s(22px); height: root.s(45px);
            text: root.empty-text; color: root.secondary;
            font-size: root.s(13px); overflow: elide; wrap: word-wrap;
            vertical-alignment: center;
            horizontal-alignment: root.rtl-layout ? right : left;
            visible: root.quote-rows.length == 0;
        }
        status_warning := Rectangle {
            x: parent.width - root.s(8px); y: root.s(7px);
            width: root.s(4px); height: self.width; border-radius: self.width / 2;
            background: root.warning;
            visible: root.market-status-warning && root.quote-rows.length > 0;
            accessible-role: image;
            accessible-label: root.status-details-label;
        }
    }

    // Passive status details use the drag surface, so they never steal dragging.
    status_details := Rectangle {
        // Physical bounds prevent fractional dirty rectangles from leaving a
        // thin row behind when a translucent overlay is shown or hidden.
        x: round((card.x + root.s(5px)) / 1phx) * 1phx;
        y: round((card.y + root.s(4px)) / 1phx) * 1phx;
        width: round((card.width - root.s(10px)) / 1phx) * 1phx;
        height: round(root.s(61px) / 1phx) * 1phx;
        background: root.surface; border-radius: root.s(6px);
        border-width: 1phx; border-color: root.edge;
        opacity: root.content-opacity / 100;
        visible: root.details-visible && root.quote-rows.length > 0;
        detail_text := Text {
            x: root.s(7px); y: root.s(3px);
            width: parent.width - root.s(14px); height: parent.height - root.s(6px);
            text: root.status-details-label;
            color: root.market-status-warning ? (root.light-theme ? #95610a : root.warning) : root.secondary;
            font-size: root.s(10px); wrap: word-wrap; overflow: elide;
            horizontal-alignment: root.rtl-layout ? right : left;
            vertical-alignment: center;
        }
    }

    // Float over the final period label, never over the pair, price or change.
    lock_button := Rectangle {
        x: round((card.x + card.width - self.width - root.s(4px)) / 1phx) * 1phx;
        y: round((card.y + card.height - self.height - root.s(2px)) / 1phx) * 1phx;
        width: round(root.s(20px) / 1phx) * 1phx; height: self.width;
        border-radius: root.s(5px);
        background: lock_touch.has-hover ? #244e68 : #15364ce8;
        border-width: root.show-lock-focus && lock_focus.has-focus ? 1phx : 0px;
        border-color: #b5e8ff;
        opacity: root.lock-revealed ? root.content-opacity / 100 : 0;
        forward-focus: lock_focus;
        accessible-role: checkbox;
        accessible-label: root.layout-lock-text;
        accessible-checkable: true;
        accessible-checked: root.layout-locked;
        accessible-action-default => { root.toggle-layout-lock(); }
        Image {
            x: root.s(3px); y: root.s(3px);
            width: root.s(14px); height: self.width;
            source: root.layout-locked ? @image-url("icons/lock.svg") : @image-url("icons/unlock.svg");
            colorize: #f0f8ff; image-fit: contain;
        }
        lock_touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.show-lock-focus = false;
                lock_focus.focus();
                root.toggle-layout-lock();
            }
        }
        lock_focus := FocusScope {
            width: 0px; height: 0px;
            key-pressed(event) => {
                root.show-lock-focus = true;
                if !event.repeat && (event.text == Key.Space || event.text == Key.Return) {
                    root.toggle-layout-lock(); return accept;
                }
                return reject;
            }
        }
    }
}
