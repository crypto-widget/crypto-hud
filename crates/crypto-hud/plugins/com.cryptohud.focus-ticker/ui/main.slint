export struct QuoteRow {
    symbol: string,
    price: string,
    change: string,
    positive: bool,
}

export component FocusTicker inherits Window {
    in property <string> widget-id;
    in property <[QuoteRow]> quote-rows;
    in property <[string]> quote-base-labels;
    in property <[string]> quote-quote-labels;
    in property <[bool]> quote-price-ready;
    in property <[string]> quote-compact-prices;
    in property <[string]> quote-full-prices;
    in property <string> pairs-heading-text;
    in property <string> source-text;
    in property <string> source-name-text: root.source-text;
    in property <string> updated-text;
    in property <string> empty-text;
    in property <string> change-period-text;
    in property <string> layout-lock-text;
    in property <bool> rtl-layout: false;
    in property <bool> pin-to-top;
    in property <bool> layout-locked;
    in property <int> widget-width: 490;
    in property <int> widget-height: 100;
    in property <float> widget-scale: 1.0;
    in property <bool> red-up-enabled;
    in property <int> content-opacity;
    in property <string> theme-name: "dark";
    in property <string> chart-line-path;
    in property <string> chart-fill-path;
    in property <bool> chart-ready;
    in property <bool> chart-positive;
    in property <int> chart-end-y-ratio;
    in-out property <bool> card-left-drag-active: false;
    in-out property <bool> show-lock-focus: false;

    property <float> content-scale: root.widget-scale;
    property <bool> light-theme: root.theme-name == "light";
    property <color> surface: root.light-theme ? #f7faff : #1c222a;
    property <color> edge: root.light-theme ? #dce3eb : #343e4a;
    property <color> primary: root.light-theme ? #101b29 : #edf1f6;
    property <color> secondary: root.light-theme ? #647489 : #a3afbf;
    property <color> gain: root.light-theme ? #23835c : #6acba0;
    property <color> loss: root.light-theme ? #d94250 : #ef7c86;
    property <color> focus-color: root.light-theme ? #326eaa : #91b5dc;
    property <color> chart-color: root.chart-positive
        ? (root.red-up-enabled ? root.loss : root.gain)
        : (root.red-up-enabled ? root.gain : root.loss);
    property <bool> has-quote: root.quote-rows.length > 0;
    property <bool> price-ready: root.quote-price-ready.length > 0 && root.quote-price-ready[0];
    property <string> base-label: root.quote-base-labels.length > 0
        ? root.quote-base-labels[0] : (root.has-quote ? root.quote-rows[0].symbol : "");
    property <string> quote-label: root.quote-quote-labels.length > 0 ? root.quote-quote-labels[0] : "";
    property <string> price-label: root.price-ready
        ? (root.quote-compact-prices.length > 0 ? root.quote-compact-prices[0] : root.quote-rows[0].price)
        : root.updated-text;
    property <string> price-full-label: root.price-ready
        ? (root.quote-full-prices.length > 0 ? root.quote-full-prices[0] : root.quote-rows[0].price) : "";
    property <string> change-label: root.has-quote ? root.quote-rows[0].change : "";
    property <float> pair-fit: min(1, (root.s(112px) - 2px)
        / max(1px, base_measure.preferred-width + quote_measure.preferred-width + root.s(6px)));
    property <length> price-font-size: root.s(root.price-ready ? 38px : 22px) * min(1,
        (root.price-ready ? root.s(167px) : root.s(168px) - max(2px, root.s(2px)))
        / max(1px, price_measure.preferred-width));
    property <length> plot-width: root.s(146px);
    property <bool> lock-revealed: drag_area.has-hover || lock_touch.has-hover
        || lock_touch.pressed || root.card-left-drag-active
        || (root.show-lock-focus && lock_focus.has-focus);
    property <bool> price-details-visible: root.price-ready && drag_area.has-hover
        && !root.card-left-drag-active
        && drag_area.mouse-x >= card.x + root.s(134px)
        && drag_area.mouse-x <= card.x + root.s(302px)
        && drag_area.mouse-y >= card.y + root.s(6px)
        && drag_area.mouse-y <= card.y + root.s(52px);

    callback drag-move(length, length);
    callback toggle-layout-lock();
    function s(value: length) -> length {
        return value * root.content-scale;
    }

    title: root.widget-id;
    width: root.widget-width * 1px;
    height: root.widget-height * 1px;
    no-frame: true;
    always-on-top: root.pin-to-top;
    background: transparent;
    default-font-family: "Segoe UI";
    forward-focus: lock_focus;

    // Reference-size measurements keep fitted text independent of its own width.
    base_measure := Text { text: root.base-label; font-size: root.s(21px); font-weight: 600; visible: false; }
    quote_measure := Text { text: root.quote-label; font-size: root.s(16px); font-weight: 400; visible: false; }
    price_measure := Text { text: root.price-label; font-size: root.s(root.price-ready ? 38px : 22px); font-weight: 500; visible: false; }
    full_price_measure := Text { text: root.price-full-label; font-size: root.s(14px); visible: false; }
    change_measure := Text {
        text: root.change-label;
        font-family: "Segoe UI";
        font-size: root.s(20px);
        font-weight: 600;
        visible: false;
    }

    drag_area := TouchArea {
        width: root.widget-width * 1px;
        height: root.widget-height * 1px;
        mouse-cursor: root.layout-locked ? default : (self.pressed ? grabbing : grab);
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.show-lock-focus = false;
            }
            if !root.layout-locked && event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.card-left-drag-active = true;
            } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                root.card-left-drag-active = false;
            }
        }
        moved => {
            if !root.layout-locked && root.card-left-drag-active {
                root.drag-move(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
    }

    card := Rectangle {
        x: (root.width - root.s(470px)) / 2;
        y: (root.height - root.s(80px)) / 2;
        width: root.s(470px);
        height: root.s(80px);
        background: root.surface;
        border-radius: root.s(10px);
        border-width: root.s(1px);
        border-color: root.edge;
        drop-shadow-offset-y: root.s(2px);
        drop-shadow-blur: root.s(8px);
        drop-shadow-color: root.light-theme ? #17273e16 : #00000028;
        opacity: root.content-opacity / 100;

        for quote[index] in root.quote-rows : Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;
            visible: index == 0;

            base_text := Text {
                x: root.s(14px); y: root.s(10px);
                width: base_measure.preferred-width * root.pair-fit; height: root.s(31px);
                text: root.base-label;
                color: root.primary;
                font-size: root.s(21px) * root.pair-fit;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                x: base_text.x + base_text.width + root.s(6px) * root.pair-fit; y: root.s(12px);
                width: quote_measure.preferred-width * root.pair-fit + root.s(2px); height: root.s(29px);
                text: root.quote-label;
                color: root.secondary;
                font-size: root.s(16px) * root.pair-fit;
                vertical-alignment: center;
            }
            Text {
                x: root.s(14px); y: root.s(50px);
                width: root.s(112px); height: root.s(22px);
                text: root.source-name-text;
                color: root.secondary;
                font-size: root.s(13px);
                horizontal-alignment: root.rtl-layout ? right : left;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: root.s(134px); y: root.s(6px);
                width: root.s(168px); height: root.s(46px);
                text: root.price-label;
                accessible-label: root.price-ready ? root.price-full-label : root.price-label;
                color: root.price-ready ? root.primary : root.secondary;
                font-size: root.price-font-size;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }
            change_text := Text {
                x: root.s(134px); y: root.s(44px);
                width: min(root.s(106px), change_measure.preferred-width + root.s(2px)); height: root.s(28px);
                text: quote.change;
                color: !root.price-ready ? root.secondary : quote.positive
                    ? (root.red-up-enabled ? root.loss : root.gain)
                    : (root.red-up-enabled ? root.gain : root.loss);
                font-size: root.s(20px) * min(1, root.s(104px) / max(1px, change_measure.preferred-width));
                font-family: "Segoe UI";
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: change_text.x + change_text.width + root.s(8px); y: root.s(50px);
                width: root.s(168px) - change_text.width - root.s(8px); height: root.s(22px);
                text: root.change-period-text;
                color: root.secondary;
                font-size: root.s(13px);
                vertical-alignment: center;
                horizontal-alignment: root.rtl-layout ? right : left;
                overflow: elide;
                visible: root.price-ready;
            }
            Path {
                x: root.s(310px); y: root.s(4px);
                width: root.plot-width; height: root.s(52px);
                viewbox-width: 100; viewbox-height: 40;
                fit: fill;
                commands: root.chart-line-path;
                fill: transparent;
                stroke: root.chart-color;
                stroke-width: root.s(1.6px);
                stroke-line-cap: round;
                stroke-line-join: round;
                visible: root.chart-ready && root.price-ready;
            }
            Rectangle {
                x: root.s(310px - 2.25px) + root.plot-width;
                y: root.s(4px + 52px * clamp(root.chart-end-y-ratio, 0, 1000) / 1000 - 2.25px);
                width: root.s(4.5px); height: root.s(4.5px);
                border-radius: root.s(2.25px);
                background: root.chart-color;
                visible: root.chart-ready && root.price-ready;
            }
            // Unavailable charts have no directional color or fabricated price trace.
            Rectangle {
                x: root.s(310px); y: root.s(30px);
                width: root.plot-width; height: root.s(1px);
                background: root.edge;
                visible: !root.chart-ready || !root.price-ready;
            }
            Text {
                x: root.s(310px); y: root.s(50px);
                width: root.s(146px); height: root.s(22px);
                text: root.updated-text;
                color: root.secondary;
                font-size: root.s(12px);
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Text {
            x: root.s(14px); y: root.s(18px);
            width: root.s(442px); height: root.s(40px);
            text: root.empty-text;
            color: root.secondary;
            font-size: root.s(18px);
            vertical-alignment: center;
            horizontal-alignment: root.rtl-layout ? right : left;
            overflow: elide;
            visible: !root.has-quote;
        }
    }

    // A passive overlay preserves price-area dragging and does not reflow the card.
    price_details := Rectangle {
        x: card.x + root.s(134px);
        y: card.y + root.s(52px);
        width: min(root.s(322px), max(root.s(168px), full_price_measure.preferred-width + root.s(20px)));
        height: root.s(24px);
        border-radius: root.s(4px);
        border-width: root.s(1px);
        border-color: root.edge;
        background: root.surface;
        opacity: root.content-opacity / 100;
        visible: root.price-details-visible;
        Text {
            x: root.s(10px); width: parent.width - root.s(20px); height: parent.height;
            text: root.price-full-label;
            color: root.primary;
            font-size: root.s(14px) * min(1, (parent.width - root.s(20px)) / max(1px, full_price_measure.preferred-width));
            vertical-alignment: center;
        }
    }

    // Keep the focus target alive while hidden; reveal on pointer or keyboard use.
    // This control overlays the chart and never reserves horizontal space.
    lock_control := Rectangle {
        x: card.x + card.width - root.s(8px) - self.width;
        y: card.y + root.s(4px);
        width: max(root.s(26px), 18px);
        height: max(root.s(26px), 18px);
        border-radius: root.s(5px);
        background: lock_touch.has-hover ? (root.light-theme ? #eaf0f7 : #29323e) : root.surface;
        border-width: root.show-lock-focus && lock_focus.has-focus ? 1.5px : 0px;
        border-color: root.focus-color;
        opacity: root.lock-revealed ? root.content-opacity / 100 : 0;
        forward-focus: lock_focus;
        accessible-role: checkbox;
        accessible-label: root.layout-lock-text;
        accessible-checkable: true;
        accessible-checked: root.layout-locked;
        accessible-action-default => { root.toggle-layout-lock(); }
        Image {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: max(root.s(17px), 12px); height: self.width;
            source: root.layout-locked ? @image-url("icons/lock.svg") : @image-url("icons/unlock.svg");
            image-fit: contain;
            colorize: root.secondary;
        }
        lock_touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.show-lock-focus = false;
                lock_focus.focus();
                root.toggle-layout-lock();
            }
        }
        lock_focus := FocusScope {
            width: 0px; height: 0px;
            key-pressed(event) => {
                root.show-lock-focus = true;
                if !event.repeat && (event.text == Key.Space || event.text == Key.Return) {
                    root.toggle-layout-lock();
                    return accept;
                }
                return reject;
            }
        }
    }
}
